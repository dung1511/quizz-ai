{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "backend:dev": "tsx server.ts",
    "django:dev": "cd backend && python manage.py runserver",
    "backend:check": "cd backend && python manage.py check && python manage.py makemigrations --check",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:gemini-retry": "tsx server/__tests__/geminiRetry.test.ts",
    "test:key-manager": "tsx server/__tests__/geminiKeyManager.test.ts",
    "test:local-exam": "tsx server/__tests__/localExam.test.ts",
    "test:ai-errors": "tsx server/__tests__/aiErrors.test.ts",
    "test:timeout-abort": "tsx server/__tests__/timeoutAbort.test.ts",
    "test:research-fetch": "npx tsx --test server/__tests__/researchFetch.test.ts",
    "test:web-research": "npx tsx --test server/__tests__/webResearch.test.ts",
    "test:question-validator": "npx tsx --test server/__tests__/questionValidator.test.ts",
    "test:ai-provider": "npx tsx --test server/__tests__/aiProvider.test.ts",
    "test:demo-exams": "npx tsx --test server/__tests__/demoExams.test.ts",
    "test:library": "tsx src/utils/__tests__/libraryUtils.test.ts",
    "test": "npm run test:gemini-retry && npm run test:key-manager && npm run test:local-exam && npm run test:ai-errors && npm run test:timeout-abort && npm run test:research-fetch && npm run test:web-research && npm run test:question-validator && npm run test:ai-provider && npm run test:demo-exams && npm run test:library"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
